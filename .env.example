# Supabase > Project (bouton "Connect") > Database

SUPABASE_DB_HOST="xxxxxxxxxxxx.pooler.supabase.com"
SUPABASE_DB_USER="postgres.xxxxxxxxxxxx"
SUPABASE_DB_PASSWORD="changeme"
SUPABASE_DB_NAME="postgres"
# Ports par défaut (6543 pooled / 5432 direct) — à ne modifier que si Supabase en fournit d'autres.
# SUPABASE_DB_PORT_POOLED=6543
# SUPABASE_DB_PORT_DIRECT=5432

PORT=3000

# Origines autorisées pour Expo Web, séparées par des virgules.
# En développement, toutes les origines sont autorisées si cette variable est absente.
# En production, l'absence de cette variable refuse toute origine web ;
# remplacez les valeurs locales par le domaine de l'application déployée.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Clé créée dans Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=changeme
# Modèle multimodal avec offre gratuite et sorties structurées.
GEMINI_MODEL=gemini-3.1-flash-lite

# Better Auth : générer un secret aléatoire d'au moins 32 caractères, par exemple
# avec `openssl rand -base64 32`. Aucun secret de développement n'est fourni ici.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_SCHEME=mogora

# Optionnel : Google Cloud Console > API & Services > Identifiants (Application Web).
# URI de redirection locale : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

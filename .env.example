# Supabase > Project (bouton "Connect") > Database

SUPABASE_DB_HOST="xxxxxxxxxxxx.pooler.supabase.com"
SUPABASE_DB_USER="postgres.xxxxxxxxxxxx"
SUPABASE_DB_PASSWORD="changeme"
SUPABASE_DB_NAME="postgres"
# Ports par défaut (6543 pooled / 5432 direct) — à ne modifier que si Supabase en fournit d'autres.
# SUPABASE_DB_PORT_POOLED=6543
# SUPABASE_DB_PORT_DIRECT=5432

PORT=3000

# URL(s) autorisée(s) pour le CORS, séparées par des virgules (ex: http://localhost:5173,https://monfront.com)
# Si absent, toutes les origines sont autorisées (utile en dev)
CORS_ORIGIN=http://localhost:5173

# Secret utilisé pour signer les tokens JWT
JWT_SECRET=changeme

# Clé créée dans Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=changeme
# Modèle multimodal avec offre gratuite et sorties structurées.
GEMINI_MODEL=gemini-3.1-flash-lite

# Google Cloud Console > API & Services > Identifiants > ID client OAuth (type "Application Web")
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com

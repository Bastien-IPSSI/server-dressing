meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "test@example.com",
    "password": "password123",
    "rememberMe": true
  }
}

docs {
  Ouvre une session Better Auth par cookie. Exécuter cette requête avant les
  requêtes protégées ; elles réutilisent le cookie du cookie jar Bruno.
}

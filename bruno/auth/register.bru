meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/sign-up/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Mon prénom",
    "email": "test@example.com",
    "password": "password123"
  }
}

docs {
  Crée un utilisateur avec Better Auth et ouvre une session par cookie.
  Bruno conserve automatiquement le cookie pour les requêtes protégées suivantes.
}

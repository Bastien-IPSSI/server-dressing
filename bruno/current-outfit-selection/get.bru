meta {
  name: Get
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/current-outfit-selection
  body: none
  auth: none
}

docs {
  Récupère la sélection courante de vêtements sur le mannequin de l'utilisateur authentifié (un vêtement au plus par catégorie).

  ### Réponses
  - `200` — la sélection courante (tableau, un élément par catégorie sélectionnée)
}

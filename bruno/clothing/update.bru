meta {
  name: Update
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/clothing/:id
  body: json
  auth: bearer
}

params:path {
  id: 1
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "T-shirt blanc",
    "color": "WHITE",
    "material": "COTTON"
  }
}

docs {
  Modifie un vêtement appartenant à l'utilisateur authentifié.
  
  ### Params
  - `id` (string, requis)
  
  ### Body (tous optionnels)
  - `name` (string, max. 120 caractères)
  - `category` (string, enum)
  - `color` (string, enum)
  - `material` (string, enum)
  - `season` (string, enum)
  - `style` (string, enum)
  
  ### Réponses
  - `200` — le vêtement modifié
  - `404` — vêtement introuvable
}

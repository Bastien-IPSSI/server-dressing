meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/clothing
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "T-shirt blanc",
    "category": "TOP",
    "color": "WHITE",
    "material": "COTTON",
    "season": "SUMMER",
    "style": "CASUAL",
    "imageAvatarUrl": "https://example.com/avatar.png",
    "imageDressingUrl": "https://example.com/dressing.png"
  }
}

docs {
  Ajoute un vêtement pour l'utilisateur authentifié.
  
  ### Body
  - `name` (string, requis, max. 120 caractères)
  - `category` (string, requis, enum)
  - `color` (string, requis, enum)
  - `material` (string, requis, enum)
  - `season` (string, requis, enum)
  - `style` (string, requis, enum)
  - `imageAvatarUrl` (string, requis)
  - `imageDressingUrl` (string, requis)
  
  ### Réponses
  - `201` — le vêtement créé
}

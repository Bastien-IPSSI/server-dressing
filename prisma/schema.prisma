// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  googleId     String?  @unique @map("google_id") @db.VarChar(255)
  username     String?  @db.VarChar(50)
  avatarUrl    String?  @map("avatar_url")
  bio          String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  clothingItems           ClothingItem[]
  outfits                 Outfit[]
  notifications           Notification[]
  currentOutfitSelections CurrentOutfitSelection[]

  @@map("users")
}

enum ClothingCategory {
  TOP
  BOTTOM
  SHOES

  @@map("clothing_category")
}

enum Season {
  SPRING
  AUTUMN
  SUMMER
  WINTER
  SPRING_SUMMER
  AUTUMN_WINTER
  ALL

  @@map("season")
}

enum ClothingStyle {
  CASUAL // Décontracté
  SMART_CASUAL // Chic décontracté
  FORMAL // Habillé / Classe
  STREETWEAR // Style urbain
  SPORTY // Sportif
  CLASSIC // Classique

  @@map("clothing_style")
}

model ClothingItem {
  id                 BigInt           @id @default(autoincrement())
  userId             BigInt           @map("user_id")
  name               String           @db.VarChar(120)
  category           ClothingCategory
  color              String           @db.VarChar(50)
  season             Season
  style              ClothingStyle
  imageAvatarUrl     String           @map("image_avatar_url")
  imageDressingUrl   String           @map("image_dressing_url")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitItems             OutfitItem[]
  currentOutfitSelections CurrentOutfitSelection[]

  @@index([userId], map: "idx_clothing_items_user_id")
  @@map("clothing_items")
}

model Outfit {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  name       String?  @db.VarChar(120)
  isFavorite Boolean  @default(false) @map("is_favorite")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OutfitItem[]

  @@index([userId], map: "idx_outfits_user_id")
  @@map("outfits")
}

model OutfitItem {
  id               BigInt @id @default(autoincrement())
  outfitId         BigInt @map("outfit_id")
  clothingItemId   BigInt @map("clothing_item_id")

  outfit       Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  clothingItem ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)

  @@unique([outfitId, clothingItemId], map: "uq_outfit_items")
  @@index([outfitId], map: "idx_outfit_items_outfit_id")
  @@index([clothingItemId], map: "idx_outfit_items_clothing_item_id")
  @@map("outfit_items")
}

model CurrentOutfitSelection {
  id             BigInt           @id @default(autoincrement())
  userId         BigInt           @map("user_id")
  clothingItemId BigInt           @map("clothing_item_id")
  category       ClothingCategory
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clothingItem ClothingItem @relation(fields: [clothingItemId], references: [id], onDelete: Cascade)

  @@unique([userId, category], map: "uq_current_outfit_selection_user_category")
  @@index([userId], map: "idx_current_outfit_selection_user_id")
  @@index([clothingItemId], map: "idx_current_outfit_selection_clothing_item_id")
  @@map("current_outfit_selection")
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(150)
  content   String?
  icon      String?  @db.VarChar(100)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_notifications_user_id")
  @@map("notifications")
}
